# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Matches the docker-compose service below. Override for your own MySQL.
DATABASE_URL=mysql://stockroom:stockroom@localhost:3306/stockroom

# Max connections in the mysql2 pool
DB_POOL_MAX=10

# CORS: comma-separated allowed origins, or * for any (dev only)
CORS_ORIGIN=*

# --- Auth ---
# Secret used to sign login tokens (JWT). REQUIRED, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts before signing in again.
JWT_EXPIRES_IN=8h

# Initial admin account — created on first start ONLY if no admin exists yet.
# After that, change the password inside the app (editing these does nothing).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
