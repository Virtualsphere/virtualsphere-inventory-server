# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Matches the docker-compose service. Change these for your own MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=stockroom
DB_PASSWORD=stockroom
DB_NAME=stockroom

# Alternative: one connection URL. If set, it overrides the DB_* values above.
# (Special characters in the password must then be URL-encoded, e.g. @ -> %40.)
# DATABASE_URL=mysql://user:password@localhost:3306/stockroom

# Max connections in the mysql2 pool
DB_POOL_MAX=10

# Throwaway database for `npm test` (tests delete all its rows). Optional.
# Uses the same host/user/password as above.
# TEST_DB_NAME=stockroom_test

# CORS: comma-separated allowed origins, or * for any (dev only)
CORS_ORIGIN=*

# Set to "loopback" when behind nginx/Apache on the same server, so the app
# sees real client IPs (needed for the login brute-force throttle).
# TRUST_PROXY=loopback

# --- Auth ---
# Secret used to sign login tokens (JWT). REQUIRED, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts before signing in again.
JWT_EXPIRES_IN=8h

# Initial admin account — created on first start ONLY if no admin exists yet.
# After that, change the password inside the app (editing these does nothing).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
